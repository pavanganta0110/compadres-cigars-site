# Copy to .env.local (never commit .env.local).
# Contact / Become-a-Customer forms are delivered via Resend (https://resend.com).
# Without these, the forms return a friendly "please call us" error.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=            # comma-separated recipients
INQUIRY_FROM_EMAIL=          # e.g. "Compadres Cigars <noreply@your-verified-domain.com>"

# 21+ age gate. AGE_GATE_SECRET is REQUIRED in production (the site refuses to open without it).
# Generate with: openssl rand -base64 32
AGE_GATE_SECRET=
AGE_GATE_TTL_DAYS=30         # how long a confirmation lasts
AGE_GATE_EXIT_URL=           # where "I am under 21" sends visitors (default https://www.google.com)

# --- Didit ID verification (21+ check on "Become a Customer") ---------------------------------
# Sign up at https://business.didit.me. All values are secrets: set them in Vercel / .env.local only.
# Without them, customer applications are refused ("please call us") because the 21+ check can't run.
DIDIT_API_KEY=               # Didit Console -> API & Webhooks. SECRET: server only
DIDIT_WORKFLOW_ID=           # Didit Console -> Workflows: a KYC workflow with ID verification only (it must return the ID's date of birth)
DIDIT_WEBHOOK_SECRET=        # Didit Console -> webhook destination "secret shared key". Destination URL: https://<your-domain>/api/didit/webhook
SITE_URL=                    # e.g. https://compadrescigars.com (where Didit sends customers back; defaults to the request origin)

# --- Authorize.net card payments (payment links for confirmed orders) -------------------------
# Customers pay on Authorize.net's own hosted page; card numbers never touch this site. Start in "sandbox"
# (free test account at developer.authorize.net, moves no real money); switch to "production" with the live keys.
# Keys: Authorize.net dashboard -> Account -> Settings -> Security Settings -> API Credentials & Keys.
# Also add a webhook there: URL https://<your-domain>/api/authnet/webhook, event "net.authorize.payment.authcapture.created".
AUTHNET_ENV=                 # "sandbox" or "production" (anything else disables payments)
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=     # SECRET
AUTHNET_SIGNATURE_KEY=       # SECRET (verifies webhooks)

# --- Admin dashboard + stored inquiries (Supabase) -------------------------------------------
# Create a NEW Supabase project for Compadres, run supabase/migrations/0001..0004 (in order) in its SQL editor.
NEXT_PUBLIC_SUPABASE_URL=            # Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Project Settings -> API -> "anon"/publishable key (safe for browsers)
SUPABASE_SERVICE_ROLE_KEY=           # Project Settings -> API -> service_role key. SECRET: server only, never in the browser
ADMIN_EMAILS=                        # comma-separated emails allowed to sign in to /admin
TRACK_SALT=                          # optional: random string for the daily visitor hash (defaults to AGE_GATE_SECRET)
