# Copy to .env.local (never commit .env.local).
# Contact / Become-a-Customer forms are delivered via Resend (https://resend.com).
# Without these, the forms return a friendly "please call us" error.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=            # comma-separated recipients
INQUIRY_FROM_EMAIL=          # e.g. "Compadres Cigars <noreply@your-verified-domain.com>"

# 21+ age gate. AGE_GATE_SECRET is REQUIRED in production (the site refuses to open without it).
# Generate with: openssl rand -base64 32
AGE_GATE_SECRET=
AGE_GATE_TTL_DAYS=30         # how long a confirmation lasts
AGE_GATE_EXIT_URL=           # where "I am under 21" sends visitors (default https://www.google.com)
